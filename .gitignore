# .gitignore for StackAlchemist (SaaS Engine)

# .NET Specific
[Bb]in/
# ...except the Tier-3 CDK entrypoint. `bin/` is a SOURCE directory in the CDK
# convention (bin/app.ts instantiates the stack), and the .NET rule above swallowed
# the whole thing: infra/cdk/bin/app.ts sat untracked on one machine while every
# clone — and therefore every Tier-3 archive built from a clone — shipped a CDK app
# with no entrypoint. Negate the DIRECTORY: git cannot re-include a file whose
# parent directory is excluded.
!src/StackAlchemist.Templates/*/infra/cdk/bin/
[Oo]bj/
*.user
*.userosscache
*.sln.docstates
.vs/

# Node.js Specific
node_modules/
.next/
dist/
build/
test-results/
coverage/
*.tsbuildinfo

# Secrets / private keys — never commit
*.p8
*.pem

# Local CI/Playwright trace dumps pulled via `gh run download`
tmp/
.playwright-mcp/

# Environment Variable Files (generated by GitHub Actions per environment)
.env
.env.*
!.env.example
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
pnpm-lock.yaml

# OS and IDE Specific
.DS_Store
Thumbs.db
.vscode/
.idea/

# StackAlchemist Generation Engine (Temporary)
temp/
reconstruction/
*.zip
logs/
generated_repos/

# Supabase Local Development
supabase/.temp/
supabase/functions/.env

# AI Agent Specific
AGENTS.md
claude.md
docs/DEV_PROMPT.md
.claude/

# Design reference extracts
style-extracted/
.pnpm-store/

# Squirrelscan audit output (snapshots, not source)
squirrel-audit-*.txt
squirrel-audit-*.json
squirrel-audit-*.html
*.lscache

# OAuth/API credential payloads — never commit (a payload_fixed.json leaked a Google client_secret on 2026-06-11)
payload*.json
